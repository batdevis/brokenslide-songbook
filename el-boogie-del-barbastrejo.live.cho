| G . . . | G . . . | G . . . | G . . . |
{end_of_grid}

{start_of_verse: V3}
{x_bars: 4}
[G]bon gnanca a dormire
[G]gol cuore coe visighe
[G]fasso pensieri bruti
[G]i brassi trema tuti
{end_of_verse}

{start_of_grid: label="Brk" shape="4x4"}
{x_bars: 4}
| G . . . | G . . . | G . . . | G . . . |
{end_of_grid}

{start_of_verse: V4}
{x_bars: 4}
[G]Me sento al fresco in orto
[G]me dondoeo soa carega
[G]accordo ea me chitara
[G]co l’ampli a bataria
{end_of_verse}

