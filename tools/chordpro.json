// Layout dei PDF del songbook: font e spazi.
// Lo usa tools/render.py (chordpro --config tools/chordpro.json).
//
// I valori qui sotto sono quelli di default di ChordPro 6.101: cambiane uno,
// rilancia render.py e guarda il PDF. Le chiavi che non compaiono restano
// ai valori di default.
// Formato: JSON "rilassato" di ChordPro (commenti //, chiavi con il punto).
// Riferimento: https://chordpro.org/chordpro/chordpro-configuration-pdf/
// Config completa: chordpro --print-default-config

config.type : config
config.title : "BrokenSlide songbook"

/**************** Pagina ****************/

// Formato carta: a4, letter, oppure [larghezza, altezza] in punti.
pdf.papersize : a4

// Margini in punti (1 pt = 1/72 di pollice, circa 0,35 mm).
// margintop e marginbottom non comprendono headspace e footspace.
pdf.margintop    : 80
pdf.marginbottom : 40
pdf.marginleft   : 40
pdf.marginright  : 40

// Spazio per il titolo in testa alla pagina e per il piè di pagina.
pdf.headspace : 60
pdf.footspace : 20

// Distanza tra le colonne, se si usa {columns: 2}.
pdf.columnspace : 20

/**************** Interlinea ****************/

// Distanza tra le righe, come multiplo della dimensione del font.
pdf.spacing.title  : 1.2
pdf.spacing.lyrics : 1.2
pdf.spacing.chords : 1.2
pdf.spacing.grid   : 1.2
pdf.spacing.tab    : 1

// Righe vuote: con un valore piccolo (ad esempio 0.5) le righe vuote del
// .cho diventano uno spazio più stretto tra le sezioni.
pdf.spacing.empty : 1

/**************** Font ****************/

// Sintassi: "famiglia [stile] dimensione[; opzioni]".
// Famiglie incluse: serif, sans, mono (Times, Helvetica, Courier).
// Stili: bold, italic, bolditalic. Opzioni: background=<colore>, frame=1.
// Si può anche indicare un file di font: "/percorso/Font.ttf 12".

// Titolo del brano.
pdf.fonts.title : "serif bold 14"

// Testo (lyrics).
pdf.fonts.text : "serif 12"

// Accordi sopra il testo.
pdf.fonts.chord : "sans italic 10"

// Griglie di accordi (Intro, Inst, Pad…).
pdf.fonts.grid : "sans 10"

// Tablature.
pdf.fonts.tab : "mono 10"

// {comment}: righe di testa (tonalità, tempo, accordatura).
pdf.fonts.comment : "sans 12; background=foreground-light"

// {comment_italic}: riga compatta delle x_ (battute, parti degli strumenti).
pdf.fonts.comment_italic : "sans italic 12"

// {comment_box}: struttura e cue.
pdf.fonts.comment_box : "sans 12; frame=1"

// Piè di pagina (titolo e numero di pagina). Di default è il 60% di text,
// ma solo finché text non viene impostato qui: va quindi indicato a mano.
pdf.fonts.footer : "serif 7.2"
